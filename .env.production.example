# PostgreSQL Database credentials
POSTGRES_DB=suti_water_prod
POSTGRES_USER=suti_user_prod
POSTGRES_PASSWORD=sutiwaterpg
DATABASE_URL=postgresql://suti_user_prod:sutiwaterpg@db:5432/suti_water_prod?schema=public

# Redis
REDIS_PASSWORD=generate_a_secure_redis_password_here
REDIS_URL=redis://:generate_a_secure_redis_password_here@redis:6379

# API Configuration
PORT=5000
NODE_ENV=production

# JWT Settings
JWT_SECRET=generate_a_very_secure_jwt_secret_key_here
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=generate_a_very_secure_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary (Bisa diisi jika menggunakan cloudinary untuk nota)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend URL Configuration (Untuk CORS backend)
CLIENT_URL=https://sutiwater.com
NEXT_PUBLIC_API_URL=https://sutiwater.com/api/v1
